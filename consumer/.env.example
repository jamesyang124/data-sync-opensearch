# Kafka Configuration
KAFKA_BROKERS=localhost:9092
CONSUMER_GROUP=cdc-consumer-group

# OpenSearch Configuration
OPENSEARCH_URL=http://localhost:9200

# Health Server Configuration
HEALTH_PORT=8080

# Application Configuration (Advanced - optional)
# BATCH_SIZE=100
# MAX_RETRIES=3
# WORKER_COUNT=10

# Backpressure Configuration (Advanced - optional)
# QUEUE_SIZE=1000              # Worker queue buffer size (number of messages)
# PAUSE_THRESHOLD=0.8          # Pause consumption at 80% queue utilization (0.0-1.0)
# RESUME_THRESHOLD=0.4         # Resume consumption at 40% queue utilization (0.0-1.0)
