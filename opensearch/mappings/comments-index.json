      "sentiment_label": {
        "type": "keyword"
      },
      "country_code": {
        "type": "keyword"
      },
      "source_ts_ms": {
        "type": "long"
      },
      "created_at": {
        "type": "date",
        "format": "epoch_millis||strict_date_optional_time"
      },
      "updated_at": {
        "type": "date",
        "format": "epoch_millis||strict_date_optional_time"
