# PostgreSQL Configuration
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
POSTGRES_PORT=5432

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# OpenSearch Configuration
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_PORT=9200
DASHBOARDS_PORT=5601
OPENSEARCH_HEAP=1g

# Benchmark Configuration (007-xk6-benchmark)
# Uses BENCHMARK_ prefix to avoid collisions with other service vars.
BENCHMARK_BASE_URL=http://producer:8080
BENCHMARK_SCENARIO=sustained
BENCHMARK_TARGET_RPS=500
BENCHMARK_DURATION=120s
BENCHMARK_PREALLOCATED_VUS=100
BENCHMARK_MAX_VUS=300
BENCHMARK_SETUP_USERS=200
BENCHMARK_SETUP_VIDEOS=100
